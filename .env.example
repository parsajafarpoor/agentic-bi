# PostgreSQL connection used to generate synthetic data / run migrations (superuser or owner role)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_bi
DB_USER=postgres
DB_PASSWORD=

# Least-privilege role the agent actually queries with (see db/migrations/001_readonly_role.sql).
# Never point the agent at DB_USER/DB_PASSWORD above.
DB_AGENT_USER=agent_readonly
DB_AGENT_PASSWORD=
